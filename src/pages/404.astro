---
import Layout from '../layouts/Layout.astro';
import AppStoreBadge from '../components/AppStoreBadge.astro';
---
<Layout title="Page not found | BuzzCam" description="This page doesn’t exist." path="/404/" noindex campaign="404">
  <div class="mx-auto flex max-w-xl flex-col items-center px-4 py-32 text-center">
    <div class="brackets px-8 py-4"><span class="br-b"></span><p class="font-display text-7xl font-bold text-buzz">404</p></div>
    <h1 class="mt-10 text-3xl font-bold text-white">Out of frame.</h1>
    <p class="mt-3 text-mute">This page doesn’t exist. Try the <a href="/" class="text-buzz underline">home page</a>.</p>
    <AppStoreBadge campaign="404" class="mt-8" />
  </div>
</Layout>
