---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import AppStoreBadge from '../components/AppStoreBadge.astro';
import {
  APP_ID, SITE_URL, LOCALES, BRAND, PRICE_USD, MIN_IOS, appStoreUrl, localeHome, localeInfo,
  type LocaleCode,
} from '../data/site';
import { UI } from '../i18n/ui';
import { GUIDES } from '../data/guides';

interface Alt { hreflang: string; path: string }
interface Crumb { name: string; path: string }
interface Props {
  locale?: LocaleCode;
  title: string;
  description: string;
  path: string;
  alternates?: Alt[];
  schema?: Record<string, unknown>[];
  breadcrumbs?: Crumb[];
  ogType?: 'website' | 'article';
  noindex?: boolean;
  campaign?: string;
}
const {
  locale = 'en',
  title,
  description,
  path,
  alternates = [],
  schema = [],
  breadcrumbs = [],
  ogType = 'website',
  noindex = false,
  campaign = 'page',
} = Astro.props;

const li = localeInfo(locale);
const t = UI[locale];
const brand = BRAND[locale];
const home = localeHome(locale);
const canonical = new URL(path, SITE_URL).href;
const ogImage = new URL('/og-image.jpg', SITE_URL).href;

const appSchema = {
  '@type': 'MobileApplication',
  '@id': `${SITE_URL}/#app`,
  name: 'BuzzCam',
  alternateName: ['Buzz Cam', 'Buzz相机', 'Buzz相機', 'Buzzカメラ', 'Buzz 카메라', 'BuzzCam - ProRAW Burst Camera'],
  description:
    'BuzzCam is an iPhone camera app with a hands-free auto shutter (smile, eye contact, face or minimum number of people), a self timer that shoots a burst, interval shooting, and RAW / Apple ProRAW / 48 MP capture on supported iPhones.',
  operatingSystem: `iOS ${MIN_IOS} or later`,
  applicationCategory: 'MultimediaApplication',
  applicationSubCategory: 'Photo & Video',
  inLanguage: ['en', 'zh-Hans', 'zh-Hant', 'ja', 'ko', 'de', 'fr', 'es'],
  url: SITE_URL + '/',
  downloadUrl: appStoreUrl('us', 'schema'),
  installUrl: appStoreUrl('us', 'schema'),
  sameAs: [`https://apps.apple.com/us/app/id${APP_ID}`],
  image: `${SITE_URL}/icon-512.png`,
  screenshot: ogImage,
  offers: { '@type': 'Offer', price: PRICE_USD, priceCurrency: 'USD', availability: 'https://schema.org/InStock', category: 'one-time purchase' },
  featureList: [
    'Automatic capture: shoots when a person is in frame, a face is visible, someone smiles, faces the camera or looks at the lens',
    'Minimum people from 1 to 10, so the photographer can be in the group photo',
    'Wait for a steady pose',
    'Burst: tap to start, tap to stop',
    'Self timer of 3, 5 or 10 seconds followed by a burst',
    'Countdown light (torch flashes during the countdown)',
    'Shot interval: Fastest, 0.4 s, 1 s, 2 s, 3 s',
    'HEIF, JPEG, RAW (DNG) and Apple ProRAW; 12 MP or 48 MP on supported iPhones',
    'Ultra Wide, Wide and Telephoto lens switching',
    'No ads, no subscription, no account, no beauty filters',
  ],
  publisher: { '@id': `${SITE_URL}/#org` },
};
const graph: Record<string, unknown>[] = [
  { '@type': 'Organization', '@id': `${SITE_URL}/#org`, name: 'BuzzCam', url: SITE_URL + '/', logo: `${SITE_URL}/icon-512.png`, email: 'support@getbuzzcam.com' },
  { '@type': 'WebSite', '@id': `${SITE_URL}/#website`, name: 'BuzzCam', url: SITE_URL + '/', publisher: { '@id': `${SITE_URL}/#org` }, inLanguage: li.hreflang },
  appSchema,
  ...schema,
];
if (breadcrumbs.length) {
  graph.push({
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: new URL(c.path, SITE_URL).href })),
  });
}
const jsonLd = { '@context': 'https://schema.org', '@graph': graph };

const navBase = path === home ? '' : home;
const nav = [
  { href: `${navBase}#features`, label: t.nav.features },
  { href: `${navBase}#compare`, label: t.nav.compare },
  { href: `${navBase}#use-cases`, label: t.nav.useCases },
  { href: `${navBase}#faq`, label: t.nav.faq },
];
const langLinks = LOCALES.map((l) => {
  const alt = alternates.find((a) => a.hreflang === l.hreflang);
  return { ...l, href: alt ? alt.path : localeHome(l.code) };
});
const year = new Date().getFullYear();
---
<!doctype html>
<html lang={li.hreflang} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={new URL(a.path, SITE_URL).href} />)}
    {alternates.length > 0 && <link rel="alternate" hreflang="x-default" href={new URL(alternates.find((a) => a.hreflang === 'en')?.path ?? '/', SITE_URL).href} />}

    <!-- iOS Safari Smart App Banner: one-tap install on iPhone -->
    <meta name="apple-itunes-app" content={`app-id=${APP_ID}`} />
    <meta name="theme-color" content="#0a0a0b" />
    <meta name="color-scheme" content="dark" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="BuzzCam" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={li.ogLocale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="text/plain" title="LLM summary" href="/llms.txt" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script is:inline>document.documentElement.classList.replace('no-js','js')</script>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="min-h-dvh pb-[76px] font-sans lg:pb-0">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:rounded-lg focus:bg-buzz focus:px-4 focus:py-2 focus:text-ink">{t.skip}</a>

    <header id="site-header" class="sticky top-0 z-50 border-b border-transparent transition-colors duration-300">
      <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-4 sm:px-6">
        <a href={home} class="flex items-center gap-2.5" aria-label={`${brand} home`}>
          <Logo class="size-8" />
          <span class="text-lg font-bold tracking-tight text-white">{brand}</span>
        </a>
        <nav class="hidden items-center gap-7 text-sm text-mute md:flex" aria-label="Main">
          {nav.map((n) => <a href={n.href} class="transition hover:text-white">{n.label}</a>)}
        </nav>
        <div class="flex items-center gap-2">
          <details class="relative">
            <summary class="flex h-10 items-center gap-1 rounded-full px-3 text-sm text-mute transition hover:bg-ink-3 hover:text-white" aria-label={t.footer.language}>
              <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3Z"/></svg>
              <span class="hidden sm:inline">{li.label}</span>
            </summary>
            <ul class="absolute right-0 mt-2 w-44 overflow-hidden rounded-xl border border-line bg-ink-2 py-1 text-sm shadow-2xl">
              {langLinks.map((l) => (
                <li><a href={l.href} hreflang={l.hreflang} lang={l.hreflang} class:list={['block px-4 py-2 hover:bg-ink-3', l.code === locale ? 'text-buzz' : 'text-paper']}>{l.label}</a></li>
              ))}
            </ul>
          </details>
          <a href={appStoreUrl(li.store, `${campaign}-header`)} data-cta={`${campaign}-header`} rel="noopener"
            class="inline-flex h-10 items-center gap-1.5 rounded-full bg-buzz px-4 text-sm font-semibold text-ink transition hover:bg-buzz-2">
            {t.getApp}
            <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="border-t border-line bg-ink">
      <div class="mx-auto grid max-w-6xl gap-10 px-4 py-14 sm:px-6 md:grid-cols-[1.4fr_1fr_1fr_1fr]">
        <div>
          <a href={home} class="flex items-center gap-2.5"><Logo class="size-8" /><span class="text-lg font-bold text-white">{brand}</span></a>
          <p class="mt-4 max-w-xs text-sm leading-relaxed text-mute">{t.footer.tagline}</p>
          <AppStoreBadge locale={locale} campaign={`${campaign}-footer`} size="sm" class="mt-6" />
        </div>
        <div>
          <h2 class="text-sm font-semibold text-white">{t.footer.guides}</h2>
          <ul class="mt-4 space-y-2.5 text-sm text-mute">
            {GUIDES.map((g) => <li><a href={`/${g.slug}/`} lang="en" class="hover:text-white">{g.navLabel}</a></li>)}
          </ul>
        </div>
        <div>
          <h2 class="text-sm font-semibold text-white">{t.footer.company}</h2>
          <ul class="mt-4 space-y-2.5 text-sm text-mute">
            <li><a href={`${home}#faq`} class="hover:text-white">{t.nav.faq}</a></li>
            <li><a href="/support/" class="hover:text-white">{t.footer.support}</a></li>
            <li><a href="/privacy/" class="hover:text-white">{t.footer.privacy}</a></li>
            <li><a href={appStoreUrl(li.store, `${campaign}-footer-link`)} data-cta={`${campaign}-footer-link`} rel="noopener" class="hover:text-white">App Store</a></li>
          </ul>
        </div>
        <div>
          <h2 class="text-sm font-semibold text-white">{t.footer.language}</h2>
          <ul class="mt-4 grid grid-cols-2 gap-x-4 gap-y-2.5 text-sm text-mute md:grid-cols-1">
            {langLinks.map((l) => <li><a href={l.href} hreflang={l.hreflang} lang={l.hreflang} class:list={['hover:text-white', l.code === locale && 'text-buzz']}>{l.label}</a></li>)}
          </ul>
        </div>
      </div>
      <div class="mx-auto max-w-6xl border-t border-line px-4 py-6 text-xs leading-relaxed text-mute-2 sm:px-6">
        <p>© {year} BuzzCam. {t.footer.rights} {t.footer.appleNote}</p>
      </div>
    </footer>

    <!-- Mobile sticky download bar -->
    <div id="sticky-cta" class="fixed inset-x-0 bottom-0 z-40 border-t border-line bg-ink/95 px-4 pt-3 backdrop-blur-lg transition-transform duration-300 lg:hidden" style="padding-bottom:max(12px,env(safe-area-inset-bottom))">
      <div class="mx-auto flex max-w-md items-center gap-3">
        <Logo class="size-11 shrink-0" />
        <div class="min-w-0 flex-1">
          <p class="truncate text-sm font-semibold text-white">{t.stickyTitle}</p>
          <p class="truncate text-xs text-mute">{t.stickySub}</p>
        </div>
        <a href={appStoreUrl(li.store, `${campaign}-sticky`)} data-cta={`${campaign}-sticky`} rel="noopener"
          class="inline-flex h-10 shrink-0 items-center rounded-full bg-buzz px-5 text-sm font-bold text-ink">{t.getApp}</a>
      </div>
    </div>

    <script>
      // Header background on scroll + hide sticky CTA while the hero CTA is visible
      const header = document.getElementById('site-header');
      const sticky = document.getElementById('sticky-cta');
      const heroCta = document.querySelector('[data-hero-cta]');
      const onScroll = () => {
        const s = window.scrollY > 8;
        header?.classList.toggle('bg-ink/85', s);
        header?.classList.toggle('backdrop-blur-xl', s);
        header?.classList.toggle('border-line', s);
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();
      if (sticky && heroCta && 'IntersectionObserver' in window) {
        new IntersectionObserver(([e]) => sticky.classList.toggle('translate-y-full', e.isIntersecting)).observe(heroCta);
      }

      // Reveal on scroll
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('revealed'); io.unobserve(e.target); } });
      }, { rootMargin: '0px 0px -60px 0px', threshold: 0.05 });
      document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));

      // Download click tracking. Works with GA4 (gtag), Plausible or Cloudflare Zaraz if one is added later.
      document.addEventListener('click', (ev) => {
        const a = (ev.target as Element | null)?.closest?.('[data-cta]') as HTMLElement | null;
        if (!a) return;
        const placement = a.dataset.cta || 'unknown';
        const w = window as any;
        (w.dataLayer = w.dataLayer || []).push({ event: 'app_store_click', placement, page: location.pathname });
        w.gtag?.('event', 'app_store_click', { placement, page_path: location.pathname });
        w.plausible?.('App Store click', { props: { placement } });
        w.zaraz?.track?.('app_store_click', { placement });
      });
    </script>
  </body>
</html>
