---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Layout from '../layouts/Layout.astro';
import Phone from './Phone.astro';
import AppStoreBadge from './AppStoreBadge.astro';
import QrCode from './QrCode.astro';
import { LOCALES, BRAND, SITE_URL, localeHome, localeInfo, type LocaleCode } from '../data/site';
import type { HomeContent, PhotoKey } from '../i18n/home/types';

interface Props {
  locale: LocaleCode;
  c: HomeContent;
}
const { locale, c } = Astro.props;
const li = localeInfo(locale);
const brand = BRAND[locale];
const path = localeHome(locale);
const alternates = LOCALES.map((l) => ({ hreflang: l.hreflang, path: localeHome(l.code) }));

const photos = import.meta.glob<{ default: ImageMetadata }>('../assets/photos/*.jpg', { eager: true });
const photoFiles: Record<PhotoKey, string> = {
  solo: '02_solo_travel', ootd: '07_ootd_sheet', jump: '06_jump_sheet',
  group: '01_group_smile', tripod: '10_tripod', family: '04_family',
};
const photo = (k: PhotoKey) => {
  const f = photoFiles[k];
  return (photos[`../assets/photos/${li.cast}${f}.jpg`] ?? photos[`../assets/photos/B${f}.jpg`]).default;
};

const schema = [
  {
    '@type': 'WebPage',
    '@id': `${SITE_URL}${path}#webpage`,
    url: `${SITE_URL}${path}`,
    name: c.meta.title,
    description: c.meta.description,
    inLanguage: li.hreflang,
    about: { '@id': `${SITE_URL}/#app` },
    isPartOf: { '@id': `${SITE_URL}/#website` },
    dateModified: '2026-11-20',
  },
  {
    '@type': 'FAQPage',
    inLanguage: li.hreflang,
    mainEntity: [{ q: c.what.q, a: c.what.a }, ...c.faq.items].map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
  {
    '@type': 'HowTo',
    name: c.how.title,
    inLanguage: li.hreflang,
    step: c.how.steps.map((s, i) => ({ '@type': 'HowToStep', position: i + 1, name: s.t, text: s.d })),
  },
];
const camp = locale === 'en' ? 'home' : `home-${li.path}`;
---
<Layout locale={locale} title={c.meta.title} description={c.meta.description} path={path} alternates={alternates} schema={schema} campaign={camp}>
  <!-- HERO -->
  <section class="relative overflow-hidden">
    <div class="pointer-events-none absolute inset-0 -top-16 bg-[radial-gradient(60%_50%_at_70%_30%,rgba(255,214,10,.18),transparent_70%)]"></div>
    <div class="relative mx-auto grid max-w-6xl items-center gap-12 px-4 pb-16 pt-10 sm:px-6 lg:grid-cols-[1.1fr_1fr] lg:gap-8 lg:pb-24 lg:pt-16">
      <div class="text-center lg:text-left">
        <p class="inline-flex items-center gap-2 rounded-full border border-buzz/30 bg-buzz/10 px-3.5 py-1.5 text-sm font-semibold text-buzz">
          <span class="size-2 animate-pulse rounded-full bg-buzz" aria-hidden="true"></span>{c.hero.eyebrow}
        </p>
        <h1 class="mt-6 font-display text-[2.6rem] font-bold leading-[1.05] tracking-tight text-white text-balance sm:text-6xl lg:text-[4.2rem]">
          {c.hero.h1a}<br /><span class="text-buzz">{c.hero.h1b}</span>
        </h1>
        <p class="mx-auto mt-6 max-w-xl text-lg leading-relaxed text-mute text-pretty lg:mx-0">{c.hero.sub}</p>
        <div class="mt-8 flex flex-col items-center gap-5 sm:flex-row sm:justify-center lg:justify-start" data-hero-cta>
          <AppStoreBadge locale={locale} campaign={`${camp}-hero`} size="lg" />
          <QrCode locale={locale} campaign={`${camp}-qr`} />
        </div>
        <p class="mt-5 text-sm text-mute-2">{c.hero.price}</p>
      </div>
      <div class="relative flex items-end justify-center">
        <Phone ui={li.ui} n={3} alt={c.hero.alt2} eager class="-mr-28 mb-10 hidden w-[230px] -rotate-6 brightness-[.65] sm:block" sizes="230px" widths={[230, 460]} />
        <Phone ui={li.ui} n={1} alt={c.hero.alt1} eager chip={c.hero.chip} class="relative z-10 w-[250px] sm:w-[290px]" sizes="(min-width:640px) 290px, 250px" widths={[290, 580]} />
      </div>
    </div>
  </section>

  <!-- WHAT IS (definition block for search and AI answers) -->
  <section class="border-y border-line bg-ink-2">
    <div class="mx-auto max-w-4xl px-4 py-12 sm:px-6">
      <h2 class="text-sm font-semibold uppercase tracking-widest text-buzz">{c.what.q}</h2>
      <p class="mt-4 text-lg leading-relaxed text-paper/90 text-pretty sm:text-xl">{c.what.a}</p>
    </div>
  </section>

  <!-- HOW -->
  <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:py-28" data-reveal>
    <h2 class="text-center font-display text-3xl font-bold tracking-tight text-white text-balance sm:text-4xl">{c.how.title}</h2>
    <ol class="mt-12 grid gap-5 md:grid-cols-3">
      {c.how.steps.map((s, i) => (
        <li class="rounded-3xl border border-line bg-ink-2 p-7">
          <span class="grid size-10 place-items-center rounded-full bg-buzz font-bold text-ink">{i + 1}</span>
          <h3 class="mt-5 text-xl font-semibold text-white">{s.t}</h3>
          <p class="mt-2 leading-relaxed text-mute">{s.d}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- FEATURES -->
  <section id="features" class="scroll-mt-20 bg-gradient-to-b from-ink via-ink-2 to-ink py-20 lg:py-28">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="font-display text-3xl font-bold tracking-tight text-white text-balance sm:text-5xl">{c.features.title}</h2>
        <p class="mt-4 text-lg text-mute text-pretty">{c.features.sub}</p>
      </div>
      <div class="mt-16 space-y-24 lg:space-y-32">
        {c.features.items.map((f, i) => (
          <article class="grid items-center gap-10 lg:grid-cols-2 lg:gap-20" data-reveal>
            <div class:list={[i % 2 === 1 && 'lg:order-2']}>
              <p class="text-sm font-semibold uppercase tracking-widest text-buzz">{f.kicker}</p>
              <h3 class="mt-3 font-display text-3xl font-bold leading-tight tracking-tight text-white text-balance sm:text-4xl">{f.t}</h3>
              <p class="mt-5 text-lg leading-relaxed text-mute text-pretty">{f.d}</p>
              {f.bullets && (
                <ul class="mt-6 flex flex-wrap gap-2">
                  {f.bullets.map((b) => <li class="rounded-full border border-line bg-ink-3 px-3.5 py-1.5 text-sm text-paper">{b}</li>)}
                </ul>
              )}
            </div>
            <Phone ui={li.ui} n={f.shot} alt={f.alt} chip={f.chip} chipSide={i % 2 === 1 ? 'right' : 'left'} class="mx-auto w-[250px] sm:w-[300px]" />
          </article>
        ))}
      </div>
      <div class="mt-20 flex justify-center">
        <AppStoreBadge locale={locale} campaign={`${camp}-features`} />
      </div>
    </div>
  </section>

  <!-- COMPARE -->
  <section id="compare" class="scroll-mt-20 mx-auto max-w-5xl px-4 py-20 sm:px-6 lg:py-28" data-reveal>
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="font-display text-3xl font-bold tracking-tight text-white text-balance sm:text-4xl">{c.compare.title}</h2>
      <p class="mt-4 text-lg text-mute text-pretty">{c.compare.sub}</p>
    </div>
    <div class="mt-12 overflow-hidden rounded-3xl border border-line">
      <table class="w-full text-left text-sm sm:text-base">
        <thead class="bg-ink-2">
          <tr>
            <th scope="col" class="w-[38%] p-4 font-medium text-mute sm:p-5"><span class="sr-only">Feature</span></th>
            <th scope="col" class="p-4 font-semibold text-mute sm:p-5">{c.compare.colA}</th>
            <th scope="col" class="bg-buzz/10 p-4 font-bold text-buzz sm:p-5">{c.compare.colB}</th>
          </tr>
        </thead>
        <tbody>
          {c.compare.rows.map(([k, a, b]) => (
            <tr class="border-t border-line">
              <th scope="row" class="p-4 font-medium text-white sm:p-5">{k}</th>
              <td class="p-4 text-mute sm:p-5">{a}</td>
              <td class="bg-buzz/5 p-4 font-medium text-paper sm:p-5">{b}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="mt-4 text-center text-xs text-mute-2">{c.compare.note}</p>
  </section>

  <!-- USE CASES -->
  <section id="use-cases" class="scroll-mt-20 bg-ink-2 py-20 lg:py-28">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="font-display text-3xl font-bold tracking-tight text-white text-balance sm:text-5xl">{c.uses.title}</h2>
        <p class="mt-4 text-lg text-mute text-pretty">{c.uses.sub}</p>
      </div>
      <div class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {c.uses.items.map((u) => (
          <article class="group flex flex-col overflow-hidden rounded-3xl border border-line bg-ink" data-reveal>
            <div class="aspect-[4/3] overflow-hidden bg-ink-3">
              <Image src={photo(u.photo)} alt={u.alt} widths={[400, 700]} sizes="(min-width:1024px) 360px, (min-width:640px) 45vw, 92vw" format="webp" quality={72} loading="lazy" class="h-full w-full object-cover transition duration-500 group-hover:scale-105" />
            </div>
            <div class="flex flex-1 flex-col p-6">
              <h3 class="text-xl font-semibold text-white">{u.t}</h3>
              <p class="mt-2 flex-1 leading-relaxed text-mute">{u.d}</p>
              {u.href && u.more && (
                <a href={u.href} class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-buzz hover:underline">{u.more}<span aria-hidden="true">→</span></a>
              )}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- TRUST -->
  <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:py-28" data-reveal>
    <h2 class="text-center font-display text-3xl font-bold tracking-tight text-white text-balance sm:text-4xl">{c.trust.title}</h2>
    <ul class="mt-12 grid gap-px overflow-hidden rounded-3xl border border-line bg-line sm:grid-cols-2 lg:grid-cols-3">
      {c.trust.items.map((t) => (
        <li class="bg-ink p-7">
          <svg viewBox="0 0 24 24" class="size-6 text-buzz" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M5 12.5 10 17 19 7"/></svg>
          <h3 class="mt-4 text-lg font-semibold text-white">{t.t}</h3>
          <p class="mt-1.5 leading-relaxed text-mute">{t.d}</p>
        </li>
      ))}
    </ul>
  </section>

  <!-- SPECS -->
  <section class="mx-auto max-w-4xl px-4 pb-20 sm:px-6 lg:pb-28" data-reveal>
    <h2 class="font-display text-2xl font-bold tracking-tight text-white sm:text-3xl">{c.specs.title}</h2>
    <dl class="mt-6 divide-y divide-line rounded-3xl border border-line bg-ink-2">
      {c.specs.rows.map(([k, v]) => (
        <div class="grid gap-1 p-5 sm:grid-cols-[220px_1fr] sm:gap-6">
          <dt class="font-semibold text-white">{k}</dt>
          <dd class="text-mute">{v}</dd>
        </div>
      ))}
    </dl>
  </section>

  <!-- FAQ -->
  <section id="faq" class="scroll-mt-20 border-t border-line bg-ink-2 py-20 lg:py-28">
    <div class="mx-auto max-w-3xl px-4 sm:px-6">
      <h2 class="text-center font-display text-3xl font-bold tracking-tight text-white sm:text-4xl">{c.faq.title}</h2>
      <div class="mt-12 divide-y divide-line rounded-3xl border border-line bg-ink">
        {c.faq.items.map((f, i) => (
          <details class="group p-6" open={i < 2}>
            <summary class="flex items-start justify-between gap-6">
              <h3 class="text-lg font-semibold text-white">{f.q}</h3>
              <span class="faq-plus mt-1 text-2xl leading-none text-buzz transition-transform" aria-hidden="true">+</span>
            </summary>
            <p class="mt-3 leading-relaxed text-mute">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="relative overflow-hidden">
    <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(50%_60%_at_50%_100%,rgba(255,214,10,.22),transparent_70%)]"></div>
    <div class="relative mx-auto flex max-w-4xl flex-col items-center px-4 pb-0 pt-24 text-center sm:px-6">
      <div class="brackets px-6 py-3"><span class="br-b"></span>
        <h2 class="font-display text-4xl font-bold tracking-tight text-white text-balance sm:text-6xl">{c.cta.title}</h2>
      </div>
      <p class="mt-8 max-w-xl text-lg text-mute text-pretty">{c.cta.sub}</p>
      <div class="mt-8 flex flex-col items-center gap-5 sm:flex-row">
        <AppStoreBadge locale={locale} campaign={`${camp}-final`} size="lg" />
        <QrCode locale={locale} campaign={`${camp}-final-qr`} />
      </div>
      <p class="mt-4 text-sm text-mute-2">{brand} · {c.cta.price}</p>
      <Phone ui={li.ui} n={8} alt="" class="mx-auto mt-16 w-[250px] translate-y-12 sm:w-[300px]" />
    </div>
  </section>
</Layout>
