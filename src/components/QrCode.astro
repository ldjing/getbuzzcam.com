---
import QRCode from 'qrcode';
import { appStoreUrl, type LocaleCode, localeInfo } from '../data/site';
import { UI } from '../i18n/ui';

interface Props {
  locale?: LocaleCode;
  campaign: string;
  class?: string;
}
const { locale = 'en', campaign, class: cls = '' } = Astro.props;
const t = UI[locale];
const svg = await QRCode.toString(appStoreUrl(localeInfo(locale).store, campaign), {
  type: 'svg',
  margin: 0,
  errorCorrectionLevel: 'M',
  color: { dark: '#0a0a0b', light: '#ffffff' },
});
---
<div class:list={['hidden items-center gap-4 rounded-2xl border border-line bg-ink-2 p-3 pr-5 lg:flex', cls]}>
  <div class="size-[88px] shrink-0 rounded-lg bg-white p-2" role="img" aria-label="QR code: BuzzCam on the App Store">
    <Fragment set:html={svg} />
  </div>
  <div class="max-w-[200px] text-sm">
    <p class="font-semibold text-white">{t.scanTitle}</p>
    <p class="mt-1 leading-snug text-mute">{t.scanSub}</p>
  </div>
</div>
