---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import bezel from '../assets/bezel.webp';

interface Props {
  ui: string; // locale folder in src/assets/ui
  n: number; // 1-9
  alt: string;
  eager?: boolean;
  chip?: string;
  chipSide?: 'left' | 'right';
  class?: string;
  widths?: number[];
  sizes?: string;
}
const {
  ui,
  n,
  alt,
  eager = false,
  chip,
  chipSide = 'right',
  class: cls = '',
  widths = [300, 440, 660],
  sizes = '(min-width: 1024px) 300px, 70vw',
} = Astro.props;
const all = import.meta.glob<{ default: ImageMetadata }>('../assets/ui/*/*.jpg', { eager: true });
const key = `../assets/ui/${ui}/0${n}.jpg`;
const src = (all[key] ?? all[`../assets/ui/en-US/0${n}.jpg`]).default;
---
<figure class:list={['relative shrink-0', cls || 'mx-auto w-full max-w-[300px]']}>
  <!-- Bezel artwork: 980x2000, screen opening 880x1912 at (50,44), corner radius 129 -->
  <div class="relative aspect-[980/2000] drop-shadow-[0_40px_60px_rgba(0,0,0,.65)]">
    <div class="absolute left-[5.102%] top-[2.2%] h-[95.6%] w-[89.796%] overflow-hidden bg-black" style="border-radius:14.66% / 6.75%">
      <Image
        src={src}
        alt={alt}
        widths={widths}
        sizes={sizes}
        format="webp"
        quality={78}
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : 'auto'}
        class="block h-full w-full object-cover"
      />
    </div>
    <Image src={bezel} alt="" widths={[400, 800]} sizes={sizes} format="webp" quality={85} loading={eager ? 'eager' : 'lazy'}
      class="pointer-events-none absolute inset-0 h-full w-full select-none" aria-hidden="true" />
  </div>
  {chip && (
    <figcaption
      class:list={[
        'absolute top-[30%] flex items-center gap-2 rounded-full border border-buzz/40 bg-ink/90 px-3.5 py-2 text-sm font-semibold text-white shadow-xl backdrop-blur',
        chipSide === 'right' ? '-right-4 sm:-right-10' : '-left-4 sm:-left-10',
      ]}
    >
      <span class="grid size-5 place-items-center rounded-full bg-buzz text-[11px] text-ink" aria-hidden="true">✓</span>
      {chip}
    </figcaption>
  )}
</figure>
