---
const reasons = [
  {
    icon: '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>',
    title: 'Natural photos, no retouching',
    description: 'BuzzCam keeps your photos looking natural and true to the scene. Edit later in any app if you want.',
  },
  {
    icon: '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>',
    title: 'No account needed',
    description: 'Open the app and start shooting. No sign-up, no login, no cloud sync. Just pure photography.',
  },
  {
    icon: '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>',
    title: 'Zero data collection',
    description: 'Your photos stay on your device. Location tagging is optional and controlled entirely by you.',
  },
  {
    icon: '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="2" y="6" width="20" height="12" rx="2"/><circle cx="12" cy="12" r="3"/><circle cx="18" cy="9" r="0.5"/></svg>',
    title: 'ProRAW quality',
    description: 'Up to 48MP ProRAW on supported devices. Maximum detail and editing flexibility.',
  },
  {
    icon: '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>',
    title: 'One-time purchase',
    description: '$0.99 once. No subscriptions, no in-app purchases, no hidden fees. Pay once, shoot forever.',
  },
  {
    icon: '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>',
    title: 'Saves to Apple Photos',
    description: 'Shots go directly to your Photos library. Easy to view, share, and edit in any app.',
  },
];
---

<section class="bg-surface-alt py-20 md:py-28" data-reveal>
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="mb-16 text-center">
      <h2 class="mb-4 text-3xl font-bold text-text md:text-4xl">
        Why BuzzCam?
      </h2>
      <p class="mx-auto max-w-2xl text-lg text-text-muted">
        A simple, powerful burst camera that respects you and your photos.
      </p>
    </div>

    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {reasons.map((reason) => (
        <div class="flex gap-4">
          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-brand/10 text-brand">
            <Fragment set:html={reason.icon} />
          </div>
          <div>
            <h3 class="mb-1 font-semibold text-text">{reason.title}</h3>
            <p class="text-sm leading-relaxed text-text-muted">{reason.description}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
