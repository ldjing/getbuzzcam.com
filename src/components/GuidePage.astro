---
import Layout from '../layouts/Layout.astro';
import Phone from './Phone.astro';
import AppStoreBadge from './AppStoreBadge.astro';
import QrCode from './QrCode.astro';
import { SITE_URL, LAST_UPDATED } from '../data/site';
import { GUIDES, type Guide } from '../data/guides';

interface Props { g: Guide }
const { g } = Astro.props;
const path = `/${g.slug}/`;
const camp = `guide-${g.slug}`.slice(0, 40);
const related = g.related.map((s) => GUIDES.find((x) => x.slug === s)!).filter(Boolean);

const schema = [
  {
    '@type': 'Article',
    '@id': `${SITE_URL}${path}#article`,
    headline: g.h1,
    description: g.description,
    inLanguage: 'en',
    url: `${SITE_URL}${path}`,
    datePublished: LAST_UPDATED,
    dateModified: LAST_UPDATED,
    author: { '@id': `${SITE_URL}/#org` },
    publisher: { '@id': `${SITE_URL}/#org` },
    image: `${SITE_URL}/og-image.jpg`,
    about: { '@id': `${SITE_URL}/#app` },
    mainEntityOfPage: `${SITE_URL}${path}`,
  },
  {
    '@type': 'HowTo',
    name: g.stepsTitle,
    inLanguage: 'en',
    tool: [{ '@type': 'HowToTool', name: 'iPhone' }, { '@type': 'HowToTool', name: 'BuzzCam app' }],
    step: g.steps.map((s, i) => ({ '@type': 'HowToStep', position: i + 1, name: s.t, text: s.d })),
  },
  {
    '@type': 'FAQPage',
    mainEntity: g.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
const crumbs = [{ name: 'BuzzCam', path: '/' }, { name: g.navLabel, path }];
---
<Layout title={g.title} description={g.description} path={path} schema={schema} breadcrumbs={crumbs} ogType="article" campaign={camp}
  alternates={[{ hreflang: 'en', path }]}>
  <article>
    <header class="relative overflow-hidden border-b border-line">
      <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(50%_60%_at_80%_20%,rgba(255,214,10,.14),transparent_70%)]"></div>
      <div class="relative mx-auto grid max-w-6xl items-center gap-12 px-4 py-12 sm:px-6 lg:grid-cols-[1.3fr_1fr] lg:py-20">
        <div>
          <nav aria-label="Breadcrumb" class="text-sm text-mute-2">
            <a href="/" class="hover:text-white">BuzzCam</a> <span aria-hidden="true">/</span> <span class="text-mute">{g.navLabel}</span>
          </nav>
          <h1 class="mt-4 font-display text-4xl font-bold leading-[1.1] tracking-tight text-white text-balance sm:text-5xl">{g.h1}</h1>
          <div class="mt-6 rounded-2xl border-l-4 border-buzz bg-ink-2 p-5">
            <p class="text-xs font-semibold uppercase tracking-widest text-buzz">Short answer</p>
            <p class="mt-2 text-lg leading-relaxed text-paper/90 text-pretty">{g.answer}</p>
          </div>
          <div class="mt-8 flex flex-col items-start gap-5 sm:flex-row sm:items-center" data-hero-cta>
            <AppStoreBadge campaign={`${camp}-hero`} />
            <QrCode campaign={`${camp}-qr`} />
          </div>
          <p class="mt-4 text-sm text-mute-2">Updated <time datetime={LAST_UPDATED}>November 20, 2026</time> · BuzzCam for iPhone · $4.99 once, no subscription</p>
        </div>
        <Phone ui="en-US" n={g.shot} alt={g.shotAlt} chip={g.chip} eager class="mx-auto w-[250px] sm:w-[290px]" />
      </div>
    </header>

    <div class="mx-auto grid max-w-6xl gap-12 px-4 py-14 sm:px-6 lg:grid-cols-[1fr_300px] lg:py-20">
      <div class="min-w-0">
        <section class="rounded-3xl border border-line bg-ink-2 p-6 sm:p-8">
          <h2 class="text-xl font-bold text-white">Key points</h2>
          <ul class="mt-4 space-y-2.5">
            {g.keyPoints.map((k) => (
              <li class="flex gap-3 text-paper/90"><span class="mt-2 size-1.5 shrink-0 rounded-full bg-buzz" aria-hidden="true"></span>{k}</li>
            ))}
          </ul>
        </section>

        <section class="mt-12">
          <h2 class="font-display text-2xl font-bold text-white sm:text-3xl">{g.stepsTitle}</h2>
          <ol class="mt-6 grid gap-4 sm:grid-cols-2">
            {g.steps.map((s, i) => (
              <li class="rounded-2xl border border-line p-5">
                <span class="grid size-8 place-items-center rounded-full bg-buzz text-sm font-bold text-ink">{i + 1}</span>
                <h3 class="mt-3 font-semibold text-white">{s.t}</h3>
                <p class="mt-1 text-mute">{s.d}</p>
              </li>
            ))}
          </ol>
        </section>

        <div class="prose-buzz mt-6" set:html={g.body} />

        <aside class="mt-14 flex flex-col items-start gap-5 rounded-3xl border border-buzz/30 bg-buzz/10 p-7 sm:flex-row sm:items-center sm:justify-between">
          <div>
            <p class="text-xl font-bold text-white">Try it on your iPhone</p>
            <p class="mt-1 text-mute">Smile shutter, timed burst, interval shooting and ProRAW. One-time purchase.</p>
          </div>
          <AppStoreBadge campaign={`${camp}-mid`} />
        </aside>

        <section class="mt-14">
          <h2 class="font-display text-2xl font-bold text-white sm:text-3xl">FAQ</h2>
          <div class="mt-6 divide-y divide-line rounded-3xl border border-line">
            {g.faq.map((f) => (
              <div class="p-6">
                <h3 class="text-lg font-semibold text-white">{f.q}</h3>
                <p class="mt-2 leading-relaxed text-mute">{f.a}</p>
              </div>
            ))}
          </div>
        </section>
      </div>

      <aside class="space-y-6 lg:sticky lg:top-24 lg:self-start">
        <div class="rounded-3xl border border-line bg-ink-2 p-6">
          <p class="font-semibold text-white">Related guides</p>
          <ul class="mt-3 space-y-2">
            {related.map((r) => <li><a href={`/${r.slug}/`} class="text-mute hover:text-buzz">{r.h1}</a></li>)}
          </ul>
        </div>
        <div class="hidden rounded-3xl border border-line bg-ink-2 p-6 lg:block">
          <p class="font-semibold text-white">BuzzCam</p>
          <p class="mt-1 text-sm text-mute">The auto shutter and burst camera for iPhone.</p>
          <AppStoreBadge campaign={`${camp}-side`} size="sm" class="mt-4" />
        </div>
      </aside>
    </div>
  </article>
</Layout>
