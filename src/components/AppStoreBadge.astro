---
import { appStoreUrl, type LocaleCode, localeInfo } from '../data/site';
import { UI } from '../i18n/ui';

interface Props {
  locale?: LocaleCode;
  campaign: string;
  size?: 'sm' | 'md' | 'lg';
  class?: string;
}
const { locale = 'en', campaign, size = 'md', class: cls = '' } = Astro.props;
const t = UI[locale];
const href = appStoreUrl(localeInfo(locale).store, campaign);
const sizes = {
  sm: 'h-10 px-3.5 gap-2 rounded-[10px] [&_svg]:h-5',
  md: 'h-14 px-5 gap-3 rounded-[14px] [&_svg]:h-7',
  lg: 'h-16 px-6 gap-3 rounded-2xl [&_svg]:h-8',
};
---
<a
  href={href}
  rel="noopener"
  data-cta={campaign}
  aria-label={`${t.download} – ${t.badgeTop} ${t.badgeBottom}`}
  class:list={[
    'inline-flex shrink-0 items-center bg-white text-black ring-1 ring-white/10 transition',
    'hover:bg-buzz focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-buzz',
    sizes[size],
    cls,
  ]}
>
  <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor" class="w-auto">
    <path d="M16.37 1.43c0 1.14-.42 2.2-1.25 3.1-.98 1.07-2.17 1.69-3.46 1.59a3.6 3.6 0 0 1-.03-.43c0-1.09.47-2.25 1.31-3.18.42-.47.95-.86 1.6-1.17.65-.3 1.26-.47 1.83-.5.02.2.02.4.02.59Zm4.47 16.27c-.38.88-.83 1.69-1.35 2.43-.71 1.01-1.29 1.71-1.74 2.1-.69.64-1.44.96-2.24.98-.57 0-1.26-.16-2.06-.49-.8-.33-1.54-.49-2.21-.49-.71 0-1.46.16-2.27.49-.81.33-1.46.5-1.96.52-.77.03-1.53-.3-2.29-1.01-.49-.42-1.1-1.15-1.83-2.18-.79-1.1-1.43-2.38-1.93-3.84A14 14 0 0 1 .25 11.6c0-1.6.35-2.99 1.04-4.15a6.1 6.1 0 0 1 2.18-2.2 5.85 5.85 0 0 1 2.94-.83c.58 0 1.34.18 2.28.53.94.35 1.54.53 1.8.53.2 0 .87-.21 2.02-.62 1.08-.39 2-.55 2.75-.49 2.03.16 3.56.97 4.57 2.42-1.82 1.1-2.72 2.65-2.7 4.63.02 1.55.58 2.83 1.68 3.85.5.47 1.05.84 1.67 1.1-.13.38-.28.75-.43 1.1Z"/>
  </svg>
  <span class="flex flex-col items-start leading-none">
    <span class="text-[0.62em] font-medium tracking-wide opacity-80" style="font-size:max(10px,.62em)">{t.badgeTop}</span>
    <span class:list={['font-semibold tracking-tight', size === 'sm' ? 'text-base' : size === 'lg' ? 'text-2xl' : 'text-xl']}>{t.badgeBottom}</span>
  </span>
</a>
